# LoanVerify Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (optional — uses mock responses if not set)
OPENAI_API_KEY=sk-your-key-here

# Database URL (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./loanverify.db

# JWT Secret (change in production)
SECRET_KEY=your-secret-key-here

# Server
HOST=127.0.0.1
PORT=8000
