# ============================================
# LoanVerify Backend Configuration
# ============================================

# Grok AI API Key (FREE from console.x.ai)
# Get your key: https://console.x.ai -> API Keys
# Set this to enable real AI explanations
XAI_API_KEY=xai-your-key-here

# Database (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./loanverify.db

# JWT Secret (change in production)
SECRET_KEY=loanverify-secret-change-this

# Server
HOST=127.0.0.1
PORT=8000
