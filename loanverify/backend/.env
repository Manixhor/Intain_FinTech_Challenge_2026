# ============================================
# LoanVerify — Environment Variables
# ============================================
# HOW TO GET A FREE GROK API KEY:
# 1. Go to https://console.x.ai
# 2. Sign up / Log in
# 3. Go to API Keys page
# 4. Create a new API key
# 5. Paste it below (replace xai-your-key-here)
#
# That's it! The AI explanations will use Grok.
# Without a key, the app uses mock responses.
# ============================================

XAI_API_KEY=xai-your-key-here
GROK_MODEL=grok-3
DATABASE_URL=sqlite+aiosqlite:///./loanverify.db
SECRET_KEY=loanverify-secret-change-this
